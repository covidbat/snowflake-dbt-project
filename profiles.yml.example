# dbt Core: copy to ~/.dbt/profiles.yml. dbt Cloud: set connection in the UI.
pm_sales_nps:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: TRANSFORM_ROLE
      database: PM_DB
      warehouse: TRANSFORM_WH
      schema: PM
      threads: 4
